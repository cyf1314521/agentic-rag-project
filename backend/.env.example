# Milvus Configuration
# MILVUS_URI=./db/milvus.db         # Milvus Lite (local file, no server needed)
MILVUS_URI=http://localhost:19530  # Milvus standalone server
COLLECTION_NAME=papers

# Model Paths
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# auto | cuda | cpu — 检索嵌入/重排；需 venv 安装 CUDA 版 torch（见 README）
EMBEDDING_DEVICE=auto

# Retrieval Parameters
FETCH_K=20
TOP_K=5
RRF_K=60

# Cache Configuration
ENABLE_CACHE=true
CACHE_MAX_SIZE=1000

# Chat observability (grep CHAT_TRACE in logs; JSON under CHAT_TRACE_DIR)
CHAT_TRACE=true
CHAT_TRACE_SAVE=true
CHAT_TRACE_DIR=./data/traces
CHAT_TRACE_PREVIEW_CHARS=280

# LLM Configuration (Ollama example)
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=600
MAX_RETRIES=0

# Agent 容错（金字塔：REQUEST > SUB_AGENT > 单步超时）
SUB_AGENT_TIMEOUT=90
REQUEST_TIMEOUT=180
EVAL_REQUEST_TIMEOUT=300
RETRIEVE_STEP_TIMEOUT=30
GENERATE_STEP_TIMEOUT=25
REFLECT_STEP_TIMEOUT=8
SYNTHESIZE_STEP_TIMEOUT=30
RETRIEVE_MAX_RETRIES=3
RETRIEVE_RETRY_BACKOFF_MS=200,500,1000
LLM_NODE_MAX_RETRIES=2
LLM_NODE_RETRY_BACKOFF_MS=1000,3000

VLM_ENABLED=true
VLM_BASE_URL=http://localhost:8080/v1
VLM_MODEL=Qwen3-vl-4B
VLM_API_KEY=empty

# Postgres (checkpointer + session store)
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/scholar_rag

# Docling: reduce memory use during PDF parse (helps avoid std::bad_alloc on large PDFs)
DOCLING_LOW_MEMORY=true
# Save full parse output + stage timeline to JSON on each upload
SAVE_PARSE_ARTIFACT=true
PARSE_ARTIFACT_DIR=./data/parsed

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# Paper profile (compressed index per PDF at ingest)
PAPER_PROFILE_ENABLED=true
PAPER_PROFILE_MAX_SOURCE_CHARS=12000
PROFILE_DISCOVERY_TOP_K=5
INTENT_CONFIDENCE_THRESHOLD=0.75
RETRIEVAL_MIN_RERANK_SCORE=0.15

# Corpus Gate (session-relative gateway, no Milvus)
CONTENT_GATE_ENABLED=true
CONTENT_GATE_MODE=hybrid
CONTENT_GATE_MIN_SCORE=0.15
CONTENT_GATE_HIGH_SCORE=0.25
CONTENT_GATE_USE_PREV_TURN=true
CONTENT_GATE_EMB_WEIGHT=0.75
CONTENT_GATE_BM25_WEIGHT=0.25
TASK_OFF_DOMAIN_ENABLED=true
TASK_OVERRIDE_MIN_SCORE=0.35

# Evidence gate fallback (when reranker scores absent)
RETRIEVAL_MIN_FALLBACK_SCORE=0.08

# Slot inheritance across turns
SLOT_INHERITANCE_ENABLED=true

# Compliance (optional)
COMPLIANCE_GATE_ENABLED=false
COMPLIANCE_DENYLIST_PATH=./data/compliance/denylist.txt

# Synthesis grounding
GROUNDING_CHECK_ENABLED=true
GROUNDING_MIN_CITATION_RATIO=0.2

# Server
HOST=0.0.0.0
PORT=8000
